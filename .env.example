# ============================================================================
# 在线智能答题系统 - 环境变量示例
# ----------------------------------------------------------------------------
# 说明：
#   1. 本文件只包含占位符，禁止写入真实密钥。
#   2. 本地开发：复制为 workers/api/.dev.vars（已被 .gitignore 忽略）。
#   3. 生产环境：使用 `wrangler secret put <NAME>` 写入 Cloudflare Secret，
#      普通变量写在 workers/api/wrangler.toml 的 [vars] 中。
#   4. 前端不读取任何密钥，所有敏感配置只在 Worker 中可见。
# ============================================================================

# ---- DeepSeek AI（必须通过 Secret 设置）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 管理员初始化引导令牌（可选，用于 POST /api/v1/admin/bootstrap）----
# 生成方式：openssl rand -hex 32
ADMIN_SETUP_TOKEN=

# ---- 安全参数（普通变量，可写在 wrangler.toml）----
# PBKDF2 迭代次数。Cloudflare 免费版 CPU 时间有限，若出现 1102 错误请下调，
# 并在 docs/SECURITY.md 中记录取舍。生产建议使用 Workers Paid 并保持 >= 100000。
PASSWORD_ITERATIONS=100000
SESSION_TTL_HOURS=72
COOKIE_SECURE=false

# ---- 业务限制 ----
AI_ENABLED=true
AI_MAX_QUESTIONS_PER_REQUEST=50
AI_DAILY_TASK_LIMIT=20
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=8000
AI_TIMEOUT_MS=120000
UPLOAD_MAX_BYTES=10485760
TZ_OFFSET_MINUTES=480

# ---- 可选：Cloudflare R2（不配置也能使用，资料文本将存入 D1）----
